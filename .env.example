# Local: if DATABASE_URL is empty, a SQLite file (safevision.db) is used.
DATABASE_URL=
# Key the IoT module must send in the X-API-Key header to create events.
IOT_API_KEY=cambia-esta-clave
# Allowed frontend origins, comma separated (your Vercel URL goes here).
FRONTEND_ORIGINS=http://localhost:5173
TIMEZONE=America/Bogota
# Seed sample events on first start so the dashboard isn't empty.
SEED_DEMO_EVENTS=true
