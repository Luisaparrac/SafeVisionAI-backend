# Azure PostgreSQL. Special characters in the password must be URL-encoded (! -> %21, @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://app_safevision:PASSWORD@safevision-db.postgres.database.azure.com:5432/safevisionai?sslmode=require
# Key the IoT module must send in the X-API-Key header to create events.
IOT_API_KEY=cambia-esta-clave
# Allowed frontend origins, comma separated (your Vercel URL goes here).
FRONTEND_ORIGINS=http://localhost:5173
TIMEZONE=America/Bogota
