# PostgreSQL connection. Special characters in the password must be URL-encoded (! -> %21, @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Key the IoT module must send in the X-API-Key header. Use a long random value.
IOT_API_KEY=CHANGE_ME
# Allowed frontend origins, comma separated.
FRONTEND_ORIGINS=http://localhost:5173
TIMEZONE=America/Bogota
# Optional. Events kept in the in-memory recent history.
HISTORY_CAPACITY=100
# Optional. Seconds, counted from the first detection, during which a repeated IoT detection
# (same camera, type and subject) reuses that event instead of raising a new alert; 0 disables it.
DEDUP_WINDOW_SECONDS=60
