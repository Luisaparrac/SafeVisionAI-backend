# Development-only values for docker compose. Copy to .env.compose (ignored by git).
# They only work against the local container; never reuse them anywhere else.

# Local PostgreSQL container
POSTGRES_USER=safevision
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=safevision_dev

# Backend (same variables as in production, pointing to the "db" service)
DATABASE_URL=postgresql://safevision:dev-only-password@db:5432/safevision_dev
IOT_API_KEY=dev-only-iot-key
FRONTEND_ORIGINS=http://localhost:5173
TIMEZONE=America/Bogota
